# Normalise text to LF in the repository so a Linux build (Streamlit Cloud)
# gets clean files regardless of the platform that committed them.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf

# Never touch these — a line-ending rewrite would corrupt a trained model.
*.joblib binary
*.png    binary
*.xls    binary
*.xlsx   binary
